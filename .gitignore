/_site/
/.quarto/
/_planning/
.Rproj.user/
*.Rproj
/slides/*_files/
/companion/*_files/
.DS_Store
*_cache/
**/*.quarto_ipynb
/*.md
!/README.md
/.luarc.json

# Backstop against person-level files that must never be committed
*.dta
*.sav
*.por
*.rds
*.RData
.Rhistory
.Rdata
# Note: /_freeze/ is intentionally NOT ignored – it must be committed so CI can deploy without running R

# Single-page renders write their output beside the source before moving it
# into _site/; none of it belongs in git.
/tracks/**/*.html
/tracks/**/*_files/
/*.html
/*_files/
# The pages outside the build render beside their source when rendered alone
/facilitator/*.html
/facilitator/*_files/
/slides/*.html
!/slides/nav-tools.html

# The local copy of the de-identified data of the replication, from
# the data hub; R/06_replication.R writes it to data/housing_replication.csv,
# which is committed
/data-raw/score_replication/

# Copies that pCloud makes when it renames a page during a render
/*[conflicted*
**/*[conflicted*

